# PayPal (SANDBOX) — create an app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# AI assistant via OpenRouter (OpenAI-compatible API) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Database — SQLite locally, PostgreSQL in production (Render)
DATABASE_URL="file:./dev.db"
