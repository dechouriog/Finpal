# Copy to .env and fill in every value. Never commit .env.

# PayPal SANDBOX app: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live  (use "sandbox" for this project)
PAYPAL_ENV=
# Same value as PAYPAL_CLIENT_ID (used by the PayPal Checkout button in the browser)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Finpal AI via OpenRouter: https://openrouter.ai/keys (a regular key, not a management key)
OPENROUTER_API_KEY=
# e.g. anthropic/claude-haiku-5.5
OPENROUTER_MODEL=

# Local: file:./dev.db   Production: a PostgreSQL connection string
DATABASE_URL=

# Auth.js session signing secret. Generate one: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=
# Secret key for the reserved recording account: /demo/laura?key=<this value> (min. 16 characters)
DEMO_RECORDING_KEY=

# Max Finpal AI messages per user per day (protects the OpenRouter budget). Default 60.
AI_DAILY_LIMIT=
# Optional: 1 = never call the model; Finpal AI uses its deterministic guided flow only.
AI_FORCE_FALLBACK=
# PayPal webhook id (Dashboard > your app > Webhooks). Optional: without it, webhooks are ignored.
PAYPAL_WEBHOOK_ID=
