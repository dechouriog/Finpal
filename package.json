{
  "name": "finpal",
  "version": "0.1.0",
  "private": true,
  "description": "Finpal — wallet + invest + AI assistant. PayPal AI Hackathon proof of concept.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:assistant": "tsx --conditions=react-server --env-file=.env scripts/test-assistant.ts",
    "cleanup:demo": "tsx scripts/cleanup-demo.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "export:pal": "tsx --tsconfig scripts/tsconfig.scripts.json scripts/export-pal-svg.ts"
  },
  "dependencies": {
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@paypal/react-paypal-js": "^10.6.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.5.0",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.69.0",
    "next": "^15.5.29",
    "next-auth": "5.0.0-beta.32",
    "openai": "^7.52.0",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
